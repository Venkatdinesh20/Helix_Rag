# Environment configuration
# Copy this file and fill in your values. Never commit real secrets to git.

ENVIRONMENT=local

# LLM settings
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Retrieval tuning
RETRIEVAL_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=80
